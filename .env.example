# ══════════════════════════════════════════════════════════════════
# Supply Chain Alpha — Environment Configuration
# ══════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Required: LLM provider (at minimum)
# Optional: FRED + SEC for richer analysis

# ── LLM Provider ──────────────────────────────────────────────────
# "openrouter" = cloud API (dev mode, fast iteration)
# "ollama"     = local Ollama server (production, $0/month)
LLM_PROVIDER=openrouter

# ── OpenRouter (required if LLM_PROVIDER=openrouter) ──────────────
# Get a free key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ── Ollama (optional, defaults to localhost) ──────────────────────
# Only needed if Ollama runs on a different host/port
# OLLAMA_BASE_URL=http://localhost:11434/v1

# ── Model Override (optional) ─────────────────────────────────────
# Default: GLM-4.7-Flash on both providers
# OpenRouter model name: z-ai/glm-4.7-flash
# Ollama model name: glm4
# REASONING_MODEL=z-ai/glm-4.7-flash
# FAST_MODEL=z-ai/glm-4.7-flash

# ── FRED Macroeconomic Data (optional, enriches analysis) ─────────
# Free key from: https://fred.stlouisfed.org/docs/api/api_key.html
# Without this, the pipeline still works but skips macro indicators
FRED_API_KEY=your_fred_api_key_here

# ── SEC EDGAR (optional, enables SEC filing extraction) ───────────
# SEC requires an email in the User-Agent header. No account needed.
# Without this, SEC filings will be skipped.
SEC_EDGAR_EMAIL=your_email@example.com

# ── ChromaDB Persistent Storage (optional) ────────────────────────
# By default, ChromaDB stores data in ./chroma_db/ inside the project.
# Set this to an ABSOLUTE path outside the project so data survives
# git pulls, redeployments, and Streamlit restarts.
# Example (Linux/Mac): CHROMA_DB_PATH=/home/user/data/chroma_db
# Example (Windows):   CHROMA_DB_PATH=C:/data/chroma_db
# CHROMA_DB_PATH=/absolute/path/to/persistent/chroma_db

# ── Langfuse Observability (optional — LLM tracing dashboard) ────
# Sign up free at: https://cloud.langfuse.com
# Create a project → Settings → API Keys → copy both keys
LANGFUSE_PUBLIC_KEY=your_public_key_here
LANGFUSE_SECRET_KEY=your_secret_key_here
LANGFUSE_HOST=https://us.cloud.langfuse.com

# ── Token Budget (optional) ──────────────────────────────────────
# Max characters for assembled LLM prompts (prevents silent truncation)
# MAX_PROMPT_CHARS=30000

# ══════════════════════════════════════════════════════════════════
# Authentication (self-hosted Google sign-in) — backend/ FastAPI
# ══════════════════════════════════════════════════════════════════
# MarketPulse is a private beta: people sign in with Google, and only
# invited/approved emails get in. Identity comes from Google; the SESSION
# is issued and owned by our own backend (HttpOnly cookie).

# Runtime environment. In "development" the API returns a dev identity when
# no session cookie is present (so you can build without Google configured).
# In "production" the app REFUSES to start unless Google + a session secret
# are configured, and unauthenticated requests get 401.
APP_ENV=development

# ── Google OAuth 2.0 / OpenID Connect (required in production) ────
# Create credentials at https://console.cloud.google.com/apis/credentials
#   • Application type: "Web application"
#   • Authorized redirect URI (local): http://localhost:8000/api/v1/auth/callback
#   • Authorized redirect URI (prod):  https://YOUR_API_HOST/api/v1/auth/callback
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Long random string that signs the short-lived OAuth transaction cookie.
# Generate one, e.g.:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET_KEY=change_me_to_a_long_random_string

# ── Cookie / session behaviour ────────────────────────────────────
# Set COOKIE_SECURE=false for local HTTP development; keep true on HTTPS.
COOKIE_SECURE=true
# 'lax' (recommended) | 'strict' | 'none' (only if frontend & API are cross-site)
COOKIE_SAMESITE=lax
# Days a sign-in session stays valid before re-login.
SESSION_TTL_DAYS=30

# Where the backend redirects the browser after login/logout (frontend origin).
FRONTEND_BASE_URL=http://localhost:3000
# Public backend URL used to build the OAuth callback. Leave blank locally;
# set it explicitly behind a proxy/CDN, e.g. https://api.yourdomain.com
# BACKEND_BASE_URL=

# ── Bootstrap operator ────────────────────────────────────────────
# Comma-separated emails that are ALWAYS allowed and granted admin on first
# sign-in. This seeds your first operator so you can invite everyone else.
# Only these emails (plus anyone on the allow-list) can sign in.
AUTH_BOOTSTRAP_ADMIN_EMAILS=charlie.wong@mindlayer.io

# ── Free-analysis quota (app provides the AI) ─────────────────────
# Analyses a normal user may start per UTC day (operators are exempt). 0 = off.
DAILY_RUN_QUOTA=25

# ── Local dev convenience (NEVER set in production) ───────────────
# When set, every request is treated as this user (skips Google entirely).
# The app refuses to boot if this is set while APP_ENV=production.
# AUTH_BYPASS_EMAIL=dev@local