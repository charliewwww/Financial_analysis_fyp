# Build-time public config baked into the client bundle by `next build`.
# The browser calls the backend at this origin. Because the frontend
# (fyp-2.charliewwww.com) and the API (fyp-2-api.charliewwww.com) share the
# charliewwww.com site, the session cookie is sent automatically (same-site).
#
# NOTE: .env* is gitignored. When building in Cloudflare/CI instead of locally,
# set NEXT_PUBLIC_API_URL as a build environment variable there too.
NEXT_PUBLIC_API_URL=https://fyp-2-api.charliewwww.com
